PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crunch-club
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Bootstrap a manager account; existing account passwords are never overwritten.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Configure all three to enable online payments. Start with test-mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public HTTPS origin and SMTP enable password recovery and signed-in order emails.
PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Set only to the known number of trusted reverse proxies used by your host.
TRUST_PROXY_HOPS=0
